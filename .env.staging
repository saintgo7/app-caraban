# Staging Environment Configuration
NODE_ENV=staging

# Database Configuration
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=caraban_staging
DB_USER=caraban
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Backend Configuration
BACKEND_PORT=5000
JWT_SECRET=CHANGE_THIS_SECRET_KEY
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://staging.caraban.com

# Web Configuration
WEB_PORT=80
VITE_API_URL=https://api-staging.caraban.com/api

# Kakao API Keys
VITE_KAKAO_MAPS_API_KEY=your_kakao_maps_api_key
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=caraban-staging

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=staging@caraban.com
SMTP_PASSWORD=your_email_password

# Payment Configuration - PortOne
PORTONE_API_KEY=your_staging_api_key
PORTONE_API_SECRET=your_staging_api_secret
VITE_PORTONE_IMP_CODE=your_staging_imp_code

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis
REDIS_PORT=6379
