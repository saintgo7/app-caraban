# Production Environment Configuration
NODE_ENV=production

# Database Configuration
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=caraban_production
DB_USER=caraban
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# Backend Configuration
BACKEND_PORT=5000
JWT_SECRET=CHANGE_THIS_STRONG_SECRET_KEY
REFRESH_TOKEN_SECRET=CHANGE_THIS_REFRESH_SECRET_KEY
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://caraban.com,https://www.caraban.com

# Web Configuration
WEB_PORT=80
VITE_API_URL=https://api.caraban.com/api

# Kakao API Keys
VITE_KAKAO_MAPS_API_KEY=your_production_kakao_maps_api_key
VITE_KAKAO_REST_API_KEY=your_production_kakao_rest_api_key
KAKAO_REST_API_KEY=your_production_kakao_rest_api_key
KAKAO_REDIRECT_URI=https://caraban.com/auth/kakao/callback

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_production_access_key
AWS_SECRET_ACCESS_KEY=your_production_secret_key
S3_BUCKET_NAME=caraban-production

# CloudFront CDN Configuration
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
VITE_CDN_URL=https://d1234567890abc.cloudfront.net
# Custom domain (if configured)
CDN_DOMAIN=cdn.caraban.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@caraban.com
SMTP_PASSWORD=your_production_email_password

# Payment Configuration - PortOne
PORTONE_API_KEY=your_production_api_key
PORTONE_API_SECRET=your_production_api_secret
VITE_PORTONE_IMP_CODE=your_production_imp_code

# Logging
LOG_LEVEL=warn

# Rate Limiting (stricter for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/caraban.crt
SSL_KEY_PATH=/etc/ssl/private/caraban.key
