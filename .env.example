# Database Configuration
# DB_TYPE options: sqlite (default for development) | mariadb (for production)
DB_TYPE=sqlite

# SQLite Configuration (for local development)
SQLITE_PATH=./backend/database.sqlite

# MariaDB Configuration (for production/staging on AWS EC2)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caraban_erp
DB_USER=caraban
DB_PASSWORD=your_password

# Backend Configuration
BACKEND_PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_this_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Web Configuration
WEB_PORT=3000
VITE_API_URL=http://localhost:5000/api

# Kakao API Keys (Get from https://developers.kakao.com/)
VITE_KAKAO_MAPS_API_KEY=your_kakao_maps_api_key
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# Redis (Optional - for caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# AWS Configuration (Optional)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Payment Configuration - PortOne (구 아임포트)
# Get credentials from https://admin.portone.io/
PORTONE_API_KEY=your_portone_api_key
PORTONE_API_SECRET=your_portone_api_secret
VITE_PORTONE_IMP_CODE=your_portone_imp_code
